# Let's Learn — Apache config for shared hosting (Truehost / cPanel).
# This is a client-side-routed single-page app: every route (/login,
# /parent, /quiz/:id, etc.) must fall back to index.html so React Router can
# take over, since none of those paths are real files/folders on disk.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Let real files/folders (assets, icons, manifest, sw.js, etc.) serve as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> index.html (SPA routing)
  RewriteRule ^ index.html [L]
</IfModule>

# Correct MIME type for the web app manifest.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# The service worker file must always be revalidated -- never let it get
# stuck cached, or installed clients stop receiving app updates.
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|registerSW\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
